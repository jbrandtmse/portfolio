# api/.env.example — copy to api/.env for local development.
# NEVER commit api/.env — it is gitignored.

# ---------------------------------------------------------------------------
# Required — Postgres connection string (Story 3.3).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://role:password@host:5432/dbname?connect_timeout=15

# ---------------------------------------------------------------------------
# Hono service port (default: 8787).
# ---------------------------------------------------------------------------
# API_PORT=8787

# ---------------------------------------------------------------------------
# Email sending via Resend (Story 3.3 — optional; unset → mail skipped).
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# MAIL_FROM=noreply@joshuabrandt.com
# MAIL_TO=josh@joshuabrandt.com

# ---------------------------------------------------------------------------
# Guide LLM config (Story 4.3 — all optional/defaulted).
# The service starts without a live LLM; tests use the deterministic stub.
# NFR-5: never commit a real key. The key resolves from ABACUS_API_KEY env
# or IMDSv2 at runtime on the VM.
# ---------------------------------------------------------------------------

# OpenAI-compatible LLM base URL (default: VM routellm endpoint).
# GUIDE_LLM_BASE_URL=https://routellm.abacus.ai/v1

# LLM model ID for the Guide stream (default: gpt-4o-mini).
# GUIDE_LLM_MODEL=gpt-4o-mini

# Set to "1" to force the deterministic stub (no live LLM, no network).
# Automatically engaged when no API key resolves (CI/test).
# GUIDE_LLM_STUB=1

# Abacus AI API key for the Guide LLM (resolved from IMDSv2 on the VM).
# Set directly here only for local development outside the VM.
# NEVER commit a real key.
# ABACUS_API_KEY=...
