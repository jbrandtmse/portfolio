# Portfolio environment variables — COPY to `.env` and fill in locally.
# `.env` is git-ignored. NEVER commit real secrets. This file documents the
# required vars with placeholder/empty values only.

# --- Hono API service ---
# Port the Hono dev/runtime server listens on. The Astro dev proxy and the
# production nginx reverse-proxy both forward /api/* to this port.
API_PORT=8787

# --- Analytics: cookieless Umami (Story 1.10; AR-10) ---
# CONFIG, not secrets (so PUBLIC_-prefixed → exposed to the built client per
# Astro/Vite). Both must be set at BUILD time for the <head> Umami script to
# render; leave BOTH empty (the default) and the build ships ZERO analytics JS
# (NFR-1 0-JS-by-default holds; no live Umami required). Set these once the
# self-hosted Umami instance is up (its own schema on the attached Postgres) —
# see docs/launch-checklist.md.
#   PUBLIC_UMAMI_SRC          = the Umami tracker script URL, e.g.
#                               https://umami.joshuabrandt.abacusai.cloud/script.js
#   PUBLIC_UMAMI_WEBSITE_ID   = the website id (UUID) from the Umami dashboard
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=

# --- Database (used from Story 3.3 onward; attached VM Postgres) ---
# Postgres connection string. Placeholder — fill in locally / via the VM.
DATABASE_URL=

# --- Transactional email (used from Story 3.3) ---
# Resend API key for invite emails. Placeholder — fill in locally.
# When unset (default/CI/test), email is a no-op ('skipped') — Rule 4 env-gate.
RESEND_API_KEY=
# Owner notification addresses for incoming speaking inquiries. [OPEN]: set on
# the VM before launch (SPF/DKIM DNS also required — see docs/launch-checklist.md).
MAIL_FROM=noreply@example.com
MAIL_TO=owner@example.com

# --- LLM endpoint (the Guide, Epic 4) ---
# NOTE: ABACUS_API_KEY for the LLM endpoint is fetched at RUNTIME by the api
# from the VM metadata service (IMDSv2) — it is NOT stored in this file and is
# never exposed to web/ client code (AR-12, NFR-5). Listed here for awareness
# only; do not add the secret value here.
# ABACUS_API_KEY=<fetched at runtime from IMDSv2; do not store here>
