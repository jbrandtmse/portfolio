---
/**
 * BaseLayout — the site-wide document shell (AC3).
 *
 * Provides <html lang="en">, head/meta, a named JSON-LD slot (empty now —
 * Story 1.6 fills it), the page body slot, and a global footer slot placeholder
 * (the real Footer is Story 1.7). Imports the design tokens, the self-hosted
 * font, and the global baseline.
 *
 * Ships 0 JS by default: there is NO <script> and NO React island here. Every
 * later page that needs an island opts in explicitly (NFR-1). Realizes the
 * flat/hairline system — no shadow is applied to any surface (the single
 * --shadow-float token is reserved for the Guide, later epics).
 *
 * Consumed by: index.astro (this story) and every later Mirror page; Story 1.5's
 * MirrorLayout composes on top of it.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  /** Document <title>. Page-specific; defaults to the canonical name. */
  title?: string;
  /** Meta description. Optional; omitted from <head> when not provided. */
  description?: string;
  /**
   * Absolute canonical URL for this page. Optional; when provided, a
   * <link rel="canonical"> is emitted in <head>. Mirror routes pass their own
   * self URL (Story 1.5 MirrorLayout, UX-DR10); the home leaves it unset.
   */
  canonical?: string;
}

const { title = 'Joshua R. Brandt, MSE', description, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}

    {/* JSON-LD structured data — populated by Story 1.6. Empty for now. */}
    <slot name="jsonld" />
  </head>
  <body>
    {/* Page content. */}
    <slot />

    {
      /*
      Global footer slot — placeholder. The real Footer (Mirror links, /browse)
      is built in Story 1.7; consumers can pass footer content via this slot, or
      it renders empty. Marked so BaseLayout is footer-ready without shipping the
      full footer now.
    */
    }
    <footer class="site-footer">
      <slot name="footer" />
    </footer>
  </body>
</html>

<style>
  /* Footer placeholder: flat, hairline top rule, token-driven spacing. The real
     footer content + links arrive in Story 1.7; this only reserves the region. */
  .site-footer {
    border-top: 1px solid var(--color-border-hairline);
    margin-top: var(--space-section-band);
    padding: var(--space-6) var(--space-margin-desktop);
    color: var(--color-ink-secondary);
    font: var(--text-meta);
    letter-spacing: var(--letter-spacing-meta);
  }
</style>
