---
/**
 * /glass-box — the Glass Box index (Story 2.3; replaces the Story 1.5 stub).
 *
 * The curated, chronological build-story of how this site was made. A dated
 * vertical timeline spine of BMAD Method Dots (TimelineDot) and artifact cards
 * (ArtifactCard), composed through MirrorLayout (answer-first, self-canonical,
 * ONE <h1>, 0 executable JS, crawlable).
 *
 * DATA: consumes the Story 2.1 glassbox.json via the Story 2.2 loader
 * (loadGlassboxArtifacts()). The node manifest (glassbox.index.ts) defines
 * curation state + order; titles and dates come from real glassbox.json entries.
 *
 * GRACEFUL ABSENT-DATA: if glassbox.json is missing, the framing copy and
 * ghosted nodes still render; real artifact nodes are omitted. No crash.
 *
 * ACs satisfied:
 *  AC1 — dated vertical spine of BMAD Method Dots + artifact cards (TimelineDot +
 *         ArtifactCard, each real artifact maps to a Story-2.2 reader).
 *  AC2 — planning nodes + live shipping node + ghosted "As it accrues" nodes;
 *         status in text + shape never color alone; ghost = dashed + "As it accrues".
 *  AC3 — default-deny-as-taste framing; verbatim recursion beat; Glass-Box-vs-
 *         Timeline cross-link to /timeline/ (forward-ref per Rule 3: story 2.4).
 *  AC4 — spine IS a semantic <ol>; every link is a real <a>; 0 executable JS.
 *  AC5 — real glassbox.json data (slug, title, date) consumed; trailing-slash links.
 *  AC6 — exactly ONE <h1> (MirrorLayout title); ghost text uses --color-ink-ghost.
 *
 * Story 6.3: adds the GlassBoxTour deferred island — a narrated guided tour.
 *   - A <script type="application/json" id="glassbox-tour-data"> data island
 *     embeds tour data for the bootstrap to consume.
 *   - An inline <script> loads bootstrap.ts via requestIdleCallback (light, deferred).
 *   - The island mounts for all JS-on users (NOT gated behind onMotionAllowed,
 *     because the tour is an INFORMATION feature, not decorative motion).
 *   - Animated transitions (scroll, fade) live under
 *     @media (prefers-reduced-motion: no-preference) in the island CSS.
 *   - The static <ol> remains the full JS-off experience (FR-8).
 *   - JS count: this adds 1 inline <script> (joining the 2 Guide-pill scripts),
 *     raising the page total to 3 executable scripts.
 *
 * EDITORIAL (Dev Notes): NO drop-cap, NO pull-quotes — reserved for reader only.
 * Cross-link /timeline/ is a forward-reference (Story 2.4 fills it; Rule 3 note).
 */
import MirrorLayout from '../../layouts/MirrorLayout.astro';
import TimelineDot from '../../components/glassbox/TimelineDot.astro';
import ArtifactCard from '../../components/glassbox/ArtifactCard.astro';
import { loadGlassboxArtifacts } from '../../lib/glassbox';
import {
  FEATURED_SLUGS,
  SHIPPING_NODE,
  GHOST_NODES,
  PHASE_MAP,
} from '../../content/glassbox.index';
import type { GlassboxArtifact } from '../../lib/glassbox';

const LEDE =
  'Joshua R. Brandt, MSE builds in the open. The Glass Box is the curated, read-only record of the real BMAD Method artifacts behind this work — the planning, the design, and the execution, as it happened.';

const FRAMING_LEAD =
  'Not everything makes it in. The Glass Box is default-deny: only artifacts that reward reading — that show real thinking, not a polished surface — are published here. Curation is an act of taste, not gatekeeping.';

const RECURSION_BEAT =
  "You're reading the build history of the site you're reading it on. It's being built in the open, right now.";

// Load real artifact data from glassbox.json (Story 2.1/2.2 producer).
// Gracefully returns [] if the file is absent — the page still renders.
const allArtifacts = loadGlassboxArtifacts();

// Build a lookup map: slug → artifact
const artifactMap = new Map<string, GlassboxArtifact>(allArtifacts.map((a) => [a.slug, a]));

// Resolve featured nodes to real artifact data, filter missing (graceful degradation).
const featuredNodes = FEATURED_SLUGS.map((node) => {
  const artifact = artifactMap.get(node.slug);
  return artifact ? { node, artifact } : null;
})
  .filter(
    (entry): entry is { node: (typeof FEATURED_SLUGS)[number]; artifact: GlassboxArtifact } =>
      entry !== null,
  )
  // Sort chronologically by artifact date (AC5: order matches glassbox.json dates).
  .sort((a, b) => new Date(a.artifact.date).getTime() - new Date(b.artifact.date).getTime());

// Tour data: date-sorted featured artifacts with their curatorNotes.
// Ghost nodes are omitted — they have no readers (AC2 / Rule 9).
const tourArtifacts = featuredNodes.map(({ artifact }) => ({
  slug: artifact.slug,
  title: artifact.title,
  curatorNote: artifact.curatorNote,
  date: artifact.date,
}));

const tourData = JSON.stringify({
  artifacts: tourArtifacts,
  framingLead: FRAMING_LEAD,
  recursionBeat: RECURSION_BEAT,
});

// ─── Phase Map (Story 6.4) ────────────────────────────────────────────────────
// Build a resolved phase map for static rendering: join PHASE_MAP entries
// against real artifact data and the shipping node. Ghost entries (As it
// accrues) are kept as-is — they render as honest non-link placeholders.
const resolvedPhaseMap = PHASE_MAP.map((phase) => {
  const nodes = phase.slugs.map((slug) => {
    if (slug === 'shipping') {
      return {
        kind: 'shipping' as const,
        slug: 'shipping',
        title: SHIPPING_NODE.title,
        type: SHIPPING_NODE.type,
        href: SHIPPING_NODE.href,
        date: SHIPPING_NODE.date,
        curatorNote: SHIPPING_NODE.curatorNote,
      };
    }
    const artifact = artifactMap.get(slug);
    if (artifact) {
      return {
        kind: 'featured' as const,
        slug: artifact.slug,
        title: artifact.title,
        type: artifact.type,
        href: `/glass-box/${artifact.slug}/`,
        date: artifact.date,
        curatorNote: artifact.curatorNote,
      };
    }
    // Ghost slug — no reader exists (Rule 9: no fabricated link).
    return {
      kind: 'ghost' as const,
      slug,
      title:
        GHOST_NODES.find((g) => g.type === slug || g.title.toLowerCase().includes(slug))?.title ??
        slug,
      type: slug,
      href: null,
      date: null,
      curatorNote: null,
    };
  });
  return { phase, nodes };
});
---

<MirrorLayout
  heading="The Glass Box"
  lede={LEDE}
  title="The Glass Box — Joshua R. Brandt, MSE"
  description="The Glass Box — the curated, dated build-story of the real BMAD Method artifacts behind the work of Joshua R. Brandt, MSE. Planning, design, and execution, in the open."
>
  {/* ── Curation framing (AC3) ─────────────────────────────────────────── */}
  <section class="glass-box__framing" aria-label="About the Glass Box">
    <p class="glass-box__framing-lead">
      Not everything makes it in. The Glass Box is default-deny: only artifacts that reward reading
      — that show real thinking, not a polished surface — are published here. Curation is an act of
      taste, not gatekeeping.
    </p>

    {/* Verbatim recursion beat (AC3, UX-DR19) */}
    <p class="glass-box__recursion-beat">
      You're reading the build history of the site you're reading it on. It's being built in the
      open, right now.
    </p>

    {/* Glass-Box-vs-Timeline boundary (AC3; /timeline/ forward-ref → Story 2.4) */}
    <p class="glass-box__boundary-note">
      This is the <strong>Glass Box</strong> — the build history of this specific project. For the cross-project
      arc spanning all of Josh's work, see the{' '}
      <a href="/timeline/" class="glass-box__boundary-link">Master Timeline</a>.
    </p>
  </section>

  {/* ── Choose Your Path affordance (Story 6.4) ──────────────────────── */}
  {
    /*
    Two ways to explore the same artifact set:
    - Guided Tour (6.3): narrated, build-story-order, primary path.
    - Explorable Map (6.4): phase-grouped, free-browse, secondary path.
    Both are always accessible; the affordance frames the choice.
  */
  }
  <section class="glass-box__choose" aria-label="Choose your exploration path">
    <h2 class="glass-box__choose-heading">Two ways to explore</h2>
    <p class="glass-box__choose-intro">
      The same six artifacts, two lenses: a narrated build story in chronological order, or a
      self-directed map grouped by build phase.
    </p>
    <div class="glass-box__choose-paths">
      <a href="#glass-box-tour" class="glass-box__path-card">
        <span class="glass-box__path-label">Guided Tour</span>
        <span class="glass-box__path-desc">
          Narrated, build-story order — the primary path through the artifacts.
        </span>
      </a>
      <a href="#glass-box-map" class="glass-box__path-card">
        <span class="glass-box__path-label">Explorable Map</span>
        <span class="glass-box__path-desc">
          Phase-grouped, free-browse — explore any artifact in any order.
        </span>
      </a>
    </div>
  </section>

  {/* ── Tour data island (Story 6.3) ─────────────────────────────────── */}
  {/* Consumed by glassbox-tour/bootstrap.ts at runtime (JS-on path only). */}
  <script type="application/json" id="glassbox-tour-data" set:html={tourData} />

  {/* ── Explorable Phase Map (Story 6.4 — static, crawlable) ─────────── */}
  {
    /*
    AC2: Every artifact node is a real <a href="/glass-box/{slug}/"> present in
    the SSR'd HTML — reachable with JS off and by crawlers (no node gated on JS).
    AC1: Artifacts grouped into build phases (Discovery → Definition → Design →
         Launch → As it accrues); free-browse, no forced order.
    AC3: Labels/phase names trace to real curated copy; ghosts are honest
         "As it accrues" placeholders with NO fabricated reader link (Rule 9).
    The map is OUTSIDE the tour island's managed DOM so the two don't interfere.
  */
  }
  <section
    id="glass-box-map"
    class="glass-box__map"
    aria-label="Explorable phase map of build artifacts"
  >
    <h2 class="glass-box__map-heading">Explorable Map</h2>
    <p class="glass-box__map-intro">
      Browse by build phase — each card links to the artifact reader. Explore in any order.
    </p>

    {
      resolvedPhaseMap.map(({ phase, nodes }) => (
        <div class="glass-box__phase" data-phase={phase.name}>
          <h3 class="glass-box__phase-heading">
            <span class="glass-box__phase-dot" aria-hidden="true" />
            {phase.name}
          </h3>
          <p class="glass-box__phase-desc">{phase.description}</p>
          <ul class="glass-box__phase-nodes" role="list">
            {nodes.map((node) =>
              node.kind === 'ghost' ? (
                /* Ghost node — honest "As it accrues" placeholder, NO reader link (Rule 9) */
                <li class="glass-box__node glass-box__node--ghost">
                  <article class="glass-box__node-card glass-box__node-card--ghost">
                    <span class="glass-box__node-chip" aria-label={`Type: ${node.type}`}>
                      {node.type}
                    </span>
                    <h4 class="glass-box__node-title">{node.title}</h4>
                    <p class="glass-box__node-status" aria-label="Status: As it accrues">
                      As it accrues
                    </p>
                  </article>
                </li>
              ) : (
                /* Featured or shipping node — real <a href> (AC2) */
                <li class="glass-box__node">
                  <article class="glass-box__node-card">
                    <span class="glass-box__node-chip" aria-label={`Type: ${node.type}`}>
                      {node.type}
                    </span>
                    <h4 class="glass-box__node-title">{node.title}</h4>
                    {node.curatorNote && <p class="glass-box__node-note">{node.curatorNote}</p>}
                    {node.kind === 'shipping' ? (
                      <a
                        class="glass-box__node-link"
                        href={node.href}
                        aria-label={`Visit the live site: ${node.href}`}
                        rel="noopener noreferrer"
                        target="_self"
                      >
                        View →
                      </a>
                    ) : (
                      <a
                        class="glass-box__node-link"
                        href={node.href}
                        aria-label={`Read ${node.title}`}
                      >
                        Read →
                      </a>
                    )}
                  </article>
                </li>
              ),
            )}
          </ul>
        </div>
      ))
    }
  </section>

  {/* ── Build-story spine (AC1, AC2, AC4) ────────────────────────────── */}
  {
    /*
    JS-off (AC4): the spine IS a semantic <ol>. CSS positions the Dots alongside
    the cards via flex; if CSS is absent, the list degrades to a plain ordered
    list of dated artifact links. No JS needed.
    Story 6.3: featured items get data-tour-slug so the island can scroll to them.
  */
  }
  <section id="glass-box-tour" class="glass-box__spine-section" aria-label="Build story timeline">
    <h2 class="glass-box__spine-heading">Build Story</h2>
    <ol class="glass-box__spine" role="list">
      {/* ── Featured artifact nodes (AC1, AC5) ──────────────────────── */}
      {
        featuredNodes.map(({ node, artifact }) => (
          <li class="glass-box__spine-item" data-tour-slug={artifact.slug}>
            <div class="glass-box__dot-col">
              <TimelineDot state={node.dotState} />
              <span class="glass-box__spine-line" aria-hidden="true" />
            </div>
            <div class="glass-box__card-col">
              <ArtifactCard
                type={artifact.type}
                title={artifact.title}
                date={artifact.date}
                curatorNote={artifact.curatorNote}
                href={`/glass-box/${artifact.slug}/`}
              />
            </div>
          </li>
        ))
      }

      {/* ── Shipping node (AC2: non-ghosted, live site link) ──────────── */}
      <li class="glass-box__spine-item">
        <div class="glass-box__dot-col">
          <TimelineDot state="live" />
          <span class="glass-box__spine-line" aria-hidden="true"></span>
        </div>
        <div class="glass-box__card-col">
          <ArtifactCard
            type={SHIPPING_NODE.type}
            title={SHIPPING_NODE.title}
            date={SHIPPING_NODE.date}
            curatorNote={SHIPPING_NODE.curatorNote}
            href={SHIPPING_NODE.href}
            showLivePill={true}
            external={true}
            externalLabel={`Visit the live site: ${SHIPPING_NODE.href}`}
          />
          {/* Repo link — shown as a supplemental link beneath the card */}
          {
            SHIPPING_NODE.repoHref && (
              <p class="glass-box__repo-link-note">
                {SHIPPING_NODE.repoPublic ? (
                  <a
                    href={SHIPPING_NODE.repoHref}
                    class="glass-box__repo-link"
                    rel="noopener noreferrer"
                    aria-label="Public source repository on GitHub"
                  >
                    Public repository →
                  </a>
                ) : (
                  <span class="glass-box__repo-open">
                    [OPEN: public repo/commits URL to be confirmed]
                  </span>
                )}
              </p>
            )
          }
        </div>
      </li>

      {/* ── Ghosted "As it accrues" nodes (AC2) ──────────────────────── */}
      {
        GHOST_NODES.map((ghost) => (
          <li class="glass-box__spine-item glass-box__spine-item--ghost">
            <div class="glass-box__dot-col">
              <TimelineDot state="upcoming" />
              <span class="glass-box__spine-line" aria-hidden="true" />
            </div>
            <div class="glass-box__card-col">
              {/* Ghost nodes carry NO date (status is "As it accrues"); omitting
                it keeps the static build deterministic (NFR-6 — no build-time now). */}
              <ArtifactCard type={ghost.type} title={ghost.title} ghost={true} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</MirrorLayout>

<style>
  /* ─── Framing section ─────────────────────────────────────────────────── */
  .glass-box__framing {
    margin-top: var(--space-7);
    max-width: var(--measure-reading);
  }

  .glass-box__framing-lead {
    font-family: var(--font-family-base);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-ink-secondary);
  }

  /* The verbatim recursion beat — italic to signal importance. */
  .glass-box__recursion-beat {
    margin-top: var(--space-5);
    font-family: var(--font-family-base);
    font-size: var(--font-size-body);
    font-style: italic;
    line-height: var(--line-height-body);
    color: var(--color-ink-primary);
  }

  .glass-box__boundary-note {
    margin-top: var(--space-5);
    font-family: var(--font-family-base);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-ink-secondary);
  }

  .glass-box__boundary-link {
    color: var(--color-accent);
    text-decoration-line: underline;
    text-underline-offset: 2px;
  }

  .glass-box__boundary-link:hover {
    color: var(--color-accent-hover);
  }

  .glass-box__boundary-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ─── Spine section ───────────────────────────────────────────────────── */
  .glass-box__spine-section {
    margin-top: var(--space-section-band);
  }

  .glass-box__spine-heading {
    font: var(--text-h2);
    font-family: var(--font-family-base);
    letter-spacing: var(--letter-spacing-h2);
    color: var(--color-ink-primary);
    margin-bottom: var(--space-7);
  }

  /* The timeline list — reset list styles; each item is a flex row. */
  .glass-box__spine {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ─── Spine item (dot + card row) ──────────────────────────────────── */
  .glass-box__spine-item {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    position: relative;
  }

  /* Vertical spacing between spine nodes. */
  .glass-box__spine-item + .glass-box__spine-item {
    margin-top: var(--space-7);
  }

  /* ─── Dot column ─────────────────────────────────────────────────────── */
  .glass-box__dot-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    padding-top: var(--space-5); /* Align dot with card top area. */
    gap: var(--space-2);
  }

  /* Hairline spine connecting dots */
  .glass-box__spine-line {
    display: block;
    width: 1px;
    flex: 1;
    min-height: var(--space-7);
    background-color: var(--color-border-hairline);
  }

  /* Hide spine-line after the very last item */
  .glass-box__spine-item:last-child .glass-box__spine-line {
    display: none;
  }

  /* ─── Card column ────────────────────────────────────────────────────── */
  .glass-box__card-col {
    flex: 1;
    min-width: 0; /* prevent flex blowout */
  }

  /* ─── Repo link note (below shipping card) ────────────────────────────── */
  .glass-box__repo-link-note {
    margin-top: var(--space-3);
    font-family: var(--font-family-base);
    font-size: var(--font-size-meta);
    font-weight: var(--font-weight-meta);
    letter-spacing: var(--letter-spacing-meta);
    text-transform: uppercase;
  }

  .glass-box__repo-link {
    color: var(--color-ink-secondary);
    text-decoration-line: underline;
    text-underline-offset: 2px;
  }

  .glass-box__repo-link:hover {
    color: var(--color-accent);
  }

  .glass-box__repo-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .glass-box__repo-open {
    color: var(--color-ink-meta-min);
  }

  /* ─── Mobile ──────────────────────────────────────────────────────────── */
  @media (max-width: 760px) {
    .glass-box__spine-item {
      gap: var(--space-3);
    }

    .glass-box__dot-col {
      padding-top: var(--space-4);
    }
  }

  /* ─── Choose Your Path affordance (Story 6.4) ─────────────────────────── */
  .glass-box__choose {
    margin-top: var(--space-section-band);
    max-width: var(--measure-reading);
  }

  .glass-box__choose-heading {
    font: var(--text-h2);
    font-family: var(--font-family-base);
    letter-spacing: var(--letter-spacing-h2);
    color: var(--color-ink-primary);
    margin-bottom: var(--space-4);
  }

  .glass-box__choose-intro {
    font-family: var(--font-family-base);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-6);
  }

  .glass-box__choose-paths {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .glass-box__path-card {
    flex: 1;
    min-width: min(240px, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .glass-box__path-card:hover {
    border-color: #c6b89e;
  }

  .glass-box__path-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-lg);
  }

  .glass-box__path-label {
    font-family: var(--font-family-base);
    font-size: var(--font-size-meta);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-meta);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .glass-box__path-desc {
    font-family: var(--font-family-base);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-ink-secondary);
  }

  /* ─── Explorable Phase Map (Story 6.4) ──────────────────────────────── */
  .glass-box__map {
    margin-top: var(--space-section-band);
  }

  .glass-box__map-heading {
    font: var(--text-h2);
    font-family: var(--font-family-base);
    letter-spacing: var(--letter-spacing-h2);
    color: var(--color-ink-primary);
    margin-bottom: var(--space-4);
  }

  .glass-box__map-intro {
    font-family: var(--font-family-base);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-7);
    max-width: var(--measure-reading);
  }

  /* ─── Phase group ─────────────────────────────────────────────────────── */
  .glass-box__phase {
    margin-bottom: var(--space-8);
  }

  .glass-box__phase-heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font: var(--text-h3);
    font-family: var(--font-family-base);
    letter-spacing: var(--letter-spacing-h3);
    color: var(--color-ink-primary);
    margin-bottom: var(--space-2);
  }

  /* Decorative phase dot — aria-hidden (not a status carrier) */
  .glass-box__phase-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Ghost phase uses a softer dot */
  [data-phase='As it accrues'] .glass-box__phase-dot {
    background-color: var(--color-border-hairline);
    border: 1px dashed var(--color-ink-ghost);
  }

  .glass-box__phase-desc {
    font-family: var(--font-family-base);
    font-size: var(--font-size-meta);
    line-height: var(--line-height-body);
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-5);
    margin-left: calc(8px + var(--space-3)); /* align with heading text */
  }

  /* ─── Phase node list ──────────────────────────────────────────────────── */
  .glass-box__phase-nodes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .glass-box__node {
    flex: 1;
    min-width: min(220px, 100%);
