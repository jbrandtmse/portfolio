---
/**
 * /work/loandemo — the flagship case-study Mirror route (Story 1.5 stub; AC2).
 *
 * Answer-first, self-canonical, exactly one <h1> via MirrorLayout. RESOLVES the
 * forward-reference from the 1.4 Flagship teaser ("Read the loandemo case study"
 * → /work/loandemo). Epic 2 fills the body with the layered case study. 0 JS.
 *
 * The lede's first sentence names "Joshua R. Brandt, MSE" (GEO floor).
 */
import MirrorLayout from '../../layouts/MirrorLayout.astro';
import { creativeWorkJsonLd, serializeJsonLd } from '../../lib/jsonld';
import { PERSON, SITE_ORIGIN } from '../../lib/person';

const LEDE =
  'Joshua R. Brandt, MSE built loandemo as a real, end-to-end agentic-engineering case study. This is the layered story of how it was made.';

// PLACEHOLDER CreativeWork JSON-LD (Story 1.6, AC1). Epic 2 (loandemo flagship)
// replaces the description/dateCreated with the real case-study metadata. name
// is the real project name "loandemo"; author is the REAL Person (shared
// web/src/lib/person.ts); url is this route's own canonical. dateCreated is a
// deterministic fixed constant (not new Date()) so the output stays byte-stable
// (NFR-6); the [PLACEHOLDER] flag marks the provisional description.
const loandemoJsonLd = serializeJsonLd(
  creativeWorkJsonLd({
    name: 'loandemo',
    author: PERSON,
    description:
      '[PLACEHOLDER] A real, end-to-end agentic-engineering case study. Epic 2 fills the real case-study description.',
    url: `${SITE_ORIGIN}/work/loandemo/`,
    dateCreated: '2026-01-01',
  }),
);
---

<MirrorLayout
  heading="loandemo — the flagship case study"
  lede={LEDE}
  title="loandemo case study — Joshua R. Brandt, MSE"
  description="How Joshua R. Brandt, MSE built loandemo end to end — a real agentic-engineering case study, told in layers."
>
  {
    /* Structured data — PLACEHOLDER CreativeWork (real case study lands in Epic
      2). DATA, not executable JS (NFR-1). */
  }
  <script type="application/ld+json" slot="jsonld" is:inline set:html={loandemoJsonLd} />
  <p class="stub-note">
    The full case study is on its way. Epic 2 fills this page with the layered story of how loandemo
    was built, from intent to working software.
  </p>
</MirrorLayout>

<style>
  .stub-note {
    margin-top: var(--space-6);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-ink-secondary);
  }
</style>
