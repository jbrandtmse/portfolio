---
/**
 * /faq — the FAQ Mirror route (Story 1.5 stub; AC2; one of the 3 GEO routes,
 * UX-DR14). Answer-first, self-canonical, exactly one <h1> via MirrorLayout.
 *
 * RESOLVES the forward-reference from the 1.3 hero's quiet Guide entry
 * ("Or ask my Guide about the work" → /faq). Epic 4 fills the body with the Q&A
 * and the FAQPage structured data; Epic 4 also switches the hero's quiet link to
 * open the Guide island in place of this route. 0 JS.
 *
 * The lede's first sentence names "Joshua R. Brandt, MSE" (GEO floor).
 */
import MirrorLayout from '../layouts/MirrorLayout.astro';
import { faqPageJsonLd, serializeJsonLd } from '../lib/jsonld';

const LEDE =
  'Joshua R. Brandt, MSE answers the questions organizers and peers ask most. These answers are the same ones his Guide cites.';

// PLACEHOLDER FAQPage JSON-LD (Story 1.6, AC1; one of the 3 GEO routes). Epic 4
// replaces these with the real Q&A (the same answers the Guide cites). Two
// clearly-flagged placeholder pairs so the route emits a valid schema.org
// FAQPage with the required Question/acceptedAnswer→Answer shape. No exclamation
// marks (positive-assertion voice).
const faqJsonLd = serializeJsonLd(
  faqPageJsonLd([
    {
      question: '[PLACEHOLDER] What does Joshua R. Brandt, MSE speak about?',
      answer:
        'Placeholder answer. Epic 4 publishes the real Q&A here — the same answers the Guide cites.',
    },
    {
      question: '[PLACEHOLDER] How do I invite him to speak?',
      answer:
        'Placeholder answer. Epic 4 publishes the real answer, mirroring the invite path on this site.',
    },
  ]),
);
---

<MirrorLayout
  heading="Frequently asked questions"
  lede={LEDE}
  title="FAQ — Joshua R. Brandt, MSE"
  description="Answers from Joshua R. Brandt, MSE to the questions organizers and peers ask most — the same answers his Guide cites."
>
  {
    /* Structured data — PLACEHOLDER FAQPage (real Q&A lands in Epic 4). DATA, not
      executable JS (NFR-1). */
  }
  <script type="application/ld+json" slot="jsonld" is:inline set:html={faqJsonLd} />
  <p class="stub-note">
    The full set of answers is on its way. Epic 4 fills this page with the Q&amp;A — the same
    answers the Guide cites — published as crawlable FAQPage content.
  </p>
</MirrorLayout>

<style>
  .stub-note {
    margin-top: var(--space-6);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-ink-secondary);
  }
</style>
