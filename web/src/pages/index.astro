---
/**
 * Home (`/`) — the cold-landing first impression (FR-1). Story 1.3 replaces the
 * 1.2 placeholder shell with the real calm, credible hero + the audience fork.
 *
 * The hero is wrapped in <section id="hero"> — the locked scene order starts at
 * Hero (Hero → Thesis → Timeline → Speaker → Flagship → Glass Box → Close). The
 * scene-rail and the remaining scenes are Story 1.4; the Mirror routes the fork
 * points at (/speaking, /faq) are Story 1.5.
 *
 * Consumes BaseLayout + HeroStatic. Ships 0 JS (NFR-1): no React island, no
 * <script> — observably correct with JS off (one <html lang="en">, the wordmark,
 * exactly one <h1>, real <a>/<button> fork controls, the footer slot, 0 <script>
 * tags). Copy is positive-assertion, no hype, no exclamation marks.
 *
 * The answer-first lede that names "Joshua R. Brandt, MSE" in the first sentence
 * (the GEO/SEO substance for `/`) lands with the Scene-Arc content in Story 1.4;
 * the hero here establishes identity, positioning, and the ways in.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroStatic from '../components/hero/HeroStatic.astro';
---

<BaseLayout
  title="Joshua R. Brandt, MSE"
  description="A warm, structured, editorial portfolio for a 30-year engineer building at the frontier."
>
  <main class="home">
    <section id="hero" aria-label="Introduction">
      <HeroStatic />
    </section>
  </main>
</BaseLayout>
