---
/**
 * BioBlock.astro — a copy-paste bio block (Story 3.2, Task 2; AC1, AC3,
 * Decision 2/3).
 *
 * DESIGN bio-block tokens (DESIGN.md §bio-block, lines 276–285):
 *  • {colors.surface-raised} background, 1px hairline border, radius 9px
 *  • padding 22px 24px
 *  • head: word-count label ({typography.meta}) + Copy <button>; hairline divider
 *  • copy-button: outline 1px {colors.accent}, radius {rounded.md} (6px);
 *    hover fills {colors.accent}/#FFFFFF
 *  • copied-state: filled {colors.accent} + #FFFFFF check glyph — "Copied ✓"
 *  • body: {typography.body} in {colors.ink-primary} — ALWAYS selectable text
 *  • fallback note states manual selection works if copy JS fails
 *
 * NFR-1: the Copy button progressive enhancement ships as a SINGLE vanilla
 * <script> on /speaking (Decision 2 — the sanctioned NFR-1 policy change).
 * The bio text is always present as plain selectable text in the DOM (JS-off
 * copy path; AC1/AC3). No React island; no client.*.js chunk.
 *
 * AA: Copy button keyboard-operable with visible :focus-visible ring;
 * "Copied ✓" announced via aria-live="polite"/role="status" (AC4). Metric
 * and testimonial AA-contrast (navy on cream ≥ 4.5:1).
 */
import { bioWordCount } from '../../data/speaking';
import type { Bio } from '../../data/speaking';

export interface BioBlockProps {
  bio: Bio;
  /** Unique identifier for wiring the copy button to the text element. */
  bioId: string;
}

type Props = BioBlockProps;

const { bio, bioId } = Astro.props;

const textId = `bio-text-${bioId}`;
const statusId = `bio-status-${bioId}`;

/** Derived at build time — NEVER a hard-coded literal (Story 9.0 AC1). */
const wordCount = bioWordCount(bio.text);
---

<div class="bio-block">
  <div class="bio-block__head">
    <span class="bio-block__label">
      {bio.label}
      <span class="bio-block__wordcount">{wordCount}</span>
    </span>
    <button
      type="button"
      class="bio-block__copy-btn"
      data-bio-copy
      data-target={textId}
      data-status={statusId}
      data-bio-label={bio.label}
      aria-label={`Copy ${bio.label}`}
    >
      <span class="bio-block__copy-icon" aria-hidden="true"></span>
      Copy
    </button>
  </div>

  {/* The bio text — ALWAYS selectable plain text; present in DOM JS-off (AC1/AC3). */}
  <p class="bio-block__text" id={textId}>{bio.text}</p>

  {/* Word count + one-tap note */}
  <p class="bio-block__wc">{wordCount} &middot; one tap copies plain text</p>

  {/* Fallback note — always visible; states manual selection works (AC1/AC3). */}
  <p class="bio-block__fallnote">If the copy button fails, the text above is fully selectable.</p>

  {
    /*
     * aria-live/role="status" region — "Copied ✓" is announced here when the
     * copy button fires. Starts empty (polite; screen-readers announce on change).
     * (AC1, AC4, Decision 2)
     */
  }
  <span id={statusId} class="bio-block__status" role="status" aria-live="polite" aria-atomic="true"
  ></span>
</div>

<style>
  /* ─── Card shell ─────────────────────────────────────────────────────── */
  .bio-block {
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border-hairline);
    border-radius: 9px;
    padding: 22px 24px;
    box-shadow: none; /* flat — elevation.flat */
  }

  /* ─── Head row: label + copy button ─────────────────────────────────── */
  .bio-block__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3, 8px);
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border-hairline);
  }

  .bio-block__label {
    font-family: var(--font-family-base);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-secondary);
    line-height: 1;
  }

  .bio-block__wordcount {
    /* Bold accent word-count sub-label */
    color: var(--color-accent);
    font-weight: 700;
  }

  /* ─── Copy button ────────────────────────────────────────────────────── */
  .bio-block__copy-btn {
    font-family: var(--font-family-base);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    background-color: var(--color-surface-base);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md, 6px);
    padding: 7px 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1, 4px);
    transition:
      background-color 120ms ease,
      color 120ms ease,
      border-color 120ms ease;
    flex-shrink: 0;
    /* Inherit the page font (button resets needed) */
    line-height: 1;
    white-space: nowrap;
    /* Touch target: at least 44px high on mobile */
    min-height: 32px;
  }

  .bio-block__copy-btn:hover {
    background-color: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  /* Keyboard-visible :focus-visible ring (AA, AC4). */
  .bio-block__copy-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-md, 6px);
  }

  /* Copied state: filled accent + white glyph */
  .bio-block__copy-btn[data-copied] {
    background-color: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  /* ─── Copy icon (CSS clipboard glyph) ───────────────────────────────── */
  .bio-block__copy-icon {
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 1.5px solid currentColor;
    border-radius: 2px;
    position: relative;
    flex-shrink: 0;
  }

  .bio-block__copy-icon::after {
    content: '';
    position: absolute;
    left: 2px;
    top: -3px;
    width: 8px;
    height: 8px;
    border: 1.5px solid currentColor;
    border-radius: 2px;
    background-color: var(--color-surface-base);
  }

  .bio-block__copy-btn:hover .bio-block__copy-icon::after,
  .bio-block__copy-btn[data-copied] .bio-block__copy-icon::after {
    background-color: var(--color-accent);
  }

  /* ─── Bio text — always selectable (AC1/AC3) ─────────────────────────── */
  .bio-block__text {
    font-family: var(--font-family-base);
    font-size: 15px;
    line-height: 1.62;
    color: var(--color-ink-primary);
    margin: 0;
    /* Explicitly selectable — never prevent text selection */
    user-select: text;
  }

  /* ─── Word count line ───────────────────────────────────────────────── */
  .bio-block__wc {
    margin-top: 14px;
    font-family: var(--font-family-base);
    font-size: 11.5px;
    font-style: italic;
    color: var(--color-ink-meta-min, #8a8273);
    line-height: 1.4;
  }

  /* ─── Fallback note ──────────────────────────────────────────────────── */
  .bio-block__fallnote {
    margin-top: 4px;
    font-family: var(--font-family-base);
    font-size: 11px;
    color: var(--color-ink-secondary);
    line-height: 1.4;
  }

  /* ─── Status region (aria-live) — visually hidden but announced ──────── */
  .bio-block__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

{
  /*
   * ONE minimal, gated, vanilla copy-button enhancement (Decision 2 / AC3).
   *
   * This is a component <script> — Astro deduplicates and bundles it once per
   * page (the scene-rail pattern from SceneRail.astro). It wires ALL
   * [data-bio-copy] buttons on the page, so rendering two BioBlocks still
   * ships exactly one script.
   *
   * GUARD: navigator.clipboard is absent in some contexts (HTTP, old browsers).
   * JS-off: the button is present but inert; bio text is still selectable.
   *
   * NFR-1: this is the SINGLE sanctioned executable script on /speaking.
   * Sub-1KB. NOT React. No client.*.js chunk.
   */
}
<script>
  function initCopyButtons(): void {
    const COPIED_LABEL = 'Copied ✓';
    const REVERT_MS = 2200;

    document.querySelectorAll<HTMLButtonElement>('button[data-bio-copy]').forEach((btn) => {
      const targetId = btn.dataset.target;
      const statusId = btn.dataset.status;
      const bioLabel = btn.dataset.bioLabel ?? '';
      if (!targetId || !statusId) return;

      const textEl = document.getElementById(targetId);
      const statusEl = document.getElementById(statusId);
      if (!textEl || !statusEl) return;

      btn.addEventListener('click', () => {
        const bioText = textEl.textContent?.trim() ?? '';

        // Guard: clipboard API may be absent (HTTP / old browsers).
        if (!navigator.clipboard) {
          return;
        }

        navigator.clipboard.writeText(bioText).then(() => {
          // Show "Copied ✓" state on the button and announce to screen readers.
          btn.setAttribute('data-copied', '');
          // Update aria-label to reflect the copied state (AC2 — accessible name
          // tracks the visible state; the role="status" announcement is preserved).
          btn.setAttribute('aria-label', `${COPIED_LABEL} — ${bioLabel}`);
          btn.textContent = '';
          const icon = document.createElement('span');
          icon.className = 'bio-block__copy-icon';
          icon.setAttribute('aria-hidden', 'true');
          btn.appendChild(icon);
          btn.appendChild(document.createTextNode(COPIED_LABEL));
          statusEl.textContent = COPIED_LABEL;

          // Revert after a beat.
          setTimeout(() => {
            btn.removeAttribute('data-copied');
            // Restore aria-label to the copy-action name (mirrors initial SSR value).
            btn.setAttribute('aria-label', `Copy ${bioLabel}`);
            btn.textContent = '';
            const icon2 = document.createElement('span');
            icon2.className = 'bio-block__copy-icon';
            icon2.setAttribute('aria-hidden', 'true');
            btn.appendChild(icon2);
            btn.appendChild(document.createTextNode('Copy'));
            statusEl.textContent = '';
          }, REVERT_MS);
        });
      });
    });
  }

  // Run when DOM is ready (Astro hydrates before DOMContentLoaded fires for
  // inlined scripts; guard with readyState check for robustness).
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCopyButtons);
  } else {
    initCopyButtons();
  }
</script>
