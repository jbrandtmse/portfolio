---
/**
 * SceneRail — the persistent home-arc progress / jump / skip affordance
 * (Story 1.4, AC2/AC3/AC4; FR-2). DESIGN §Components → scene-rail; EXPERIENCE
 * §Component-Patterns → Scene-rail, §Responsive (rail reflow), §State-Patterns
 * (JS-off + Reduced-motion → the meter becomes a static filled bar).
 *
 * THIS IS the FR-2 skip/progress affordance — the antidote to scroll-jacking.
 * The page is scroll-native; the rail only reflects position and jumps. No
 * camera path / scroll-jacking here (that is the Stage-2 layer, Epic 5).
 *
 * Desktop  → a slim right-edge vertical rail on --color-surface-raised with a
 *            left hairline: 7 scene entries, a "Scene N of 7" progress meter, a
 *            "Skip to the end" outline button, and a "Jump: book a talk".
 * Mobile   → collapses to a sticky top progress bar + a native <details>
 *            "Jump to section" menu carrying the SAME 7 anchors + skip + jump.
 *
 * Each of the 7 scene entries is a REAL in-page anchor (<a href="#hero">…), a
 * jump-to-scene target with a ≥44×44px hit area and a visible :focus-visible
 * navy ring — followable JS-off, keyboard-operable. The decorative tick glyph is
 * aria-hidden; the scene-NAME link text carries the meaning and the navigation.
 * The current scene is signalled by aria-current="true" + label weight — NEVER
 * by color alone (the lit tick is redundant, not the sole signal).
 *
 * 0-JS baseline (AC4): aria-current sits on #hero, the meter renders as a STATIC
 * filled bar at "Scene 1 of 7", and every anchor / skip / jump works. The single
 * tiny enhancement script (below) is gated by the SHARED two-layer gate in
 * web/src/lib/motion.ts (Story 1.9, UX-DR21) — a CSS prefers-reduced-motion media
 * query (the scroll-driven meter fill) AND the JS init-guard onMotionAllowed()
 * that does nothing if reduced (the semantic aria-current tracking, which CSS
 * cannot do). The gate is NOT re-implemented here; it is imported. Keep it tiny
 * (NFR-1).
 *
 * Flat (DESIGN §Elevation): no box-shadow anywhere — depth is tone + hairline.
 * The current-tick "soft halo" is rendered with `outline` (a ring, not an
 * elevation shadow): the spine forbids box-shadow on any surface but the Guide
 * ("if any other element grows a shadow, the system is broken" — DESIGN), so the
 * mockup's box-shadow halo is rendered here as the spec-faithful flat ring.
 */

// The locked Stage-1 scene order (EXPERIENCE §"Scene order (Stage 1, locked)").
// id = the in-page anchor / matching <section> id; label = the scene-name link
// text that carries the meaning. Order here IS the DOM order in the rail.
const SCENES = [
  { id: 'hero', label: 'Hero' },
  { id: 'thesis', label: 'Thesis' },
  { id: 'timeline', label: 'Timeline' },
  { id: 'speaker', label: 'Speaker' },
  { id: 'flagship', label: 'Flagship' },
  { id: 'glass-box', label: 'Glass Box' },
  { id: 'close', label: 'Close' },
] as const;

const TOTAL = SCENES.length;
---

<nav class="scene-rail" aria-label="Scene navigation: progress, jump, and skip">
  {/* ── DESKTOP: the slim right-edge rail ─────────────────────────────────── */}
  <div class="rail-d">
    <p class="rail-d__head">Scenes · progress</p>

    <ol class="rail-d__list">
      {
        SCENES.map((scene, i) => (
          <li class="rail-d__item">
            <a
              class:list={['rail-d__link', { 'is-current': i === 0 }]}
              href={`#${scene.id}`}
              data-scene-link={scene.id}
              {...(i === 0 ? { 'aria-current': 'true' } : {})}
            >
              <span class="rail-d__tick" aria-hidden="true" />
              <span class="rail-d__num" aria-hidden="true">
                {i + 1}
              </span>
              <span class="rail-d__name">{scene.label}</span>
            </a>
          </li>
        ))
      }
    </ol>

    {
      /* Progress meter — static filled bar at the baseline; the fill width is
       driven by a CSS scroll-driven animation only when motion is allowed. The
       "Scene N of 7" text is the non-color signal (the JS enhancement updates N). */
    }
    <div class="rail-d__progress">
      <div class="rail-d__meter" aria-hidden="true">
        <span class="rail-d__meter-fill"></span>
      </div>
      <p class="rail-d__lab">Scene <span data-scene-current>1</span> of {TOTAL}</p>
    </div>

    {/* ── Depth Dial (Story 5.2, AC1/AC3) ──────────────────────────────────── */}
    {
      /*
       * A native radio <fieldset> — no JS required for the control itself (the
       * options are followable/readable without JS). A tiny enhancement script
       * below syncs radios ↔ $depth and sets data-depth on <html>. The dial is
       * NOT motion-gated (it is a control, not animation). State rides the
       * native :checked attribute — accessible via the a11y tree without color.
       */
    }
    <fieldset class="depth-dial" data-depth-dial>
      <legend class="depth-dial__legend">Depth</legend>
      <div class="depth-dial__options">
        <label class="depth-dial__label">
          <input
            class="depth-dial__radio"
            type="radio"
            name="depth"
            value="skim"
            data-depth-radio
          />
          <span class="depth-dial__text">Skim</span>
        </label>
        <label class="depth-dial__label depth-dial__label--checked">
          <input
            class="depth-dial__radio"
            type="radio"
            name="depth"
            value="overview"
            data-depth-radio
            checked
          />
          <span class="depth-dial__text">Overview</span>
        </label>
        <label class="depth-dial__label">
          <input
            class="depth-dial__radio"
            type="radio"
            name="depth"
            value="deep"
            data-depth-radio
          />
          <span class="depth-dial__text">Deep dive</span>
        </label>
      </div>
    </fieldset>

    <div class="rail-d__foot">
      <a class="rail-d__skip" href="#close"
        >Skip to the end <span aria-hidden="true">&darr;</span></a
      >
      <a class="rail-d__jump" href="/speaking/">Jump: book a talk</a>
    </div>
  </div>

  {/* ── MOBILE: sticky top progress bar + "Jump to section" disclosure ─────── */}
  <div class="rail-m">
    <div class="rail-m__bar" aria-hidden="true">
      <span class="rail-m__bar-fill"></span>
    </div>
    <details class="rail-m__menu">
      <summary class="rail-m__summary">
        <span class="rail-m__lab">Scene <span data-scene-current>1</span> of {TOTAL}</span>
        <span class="rail-m__cta">Jump to section <span aria-hidden="true">&#9662;</span></span>
      </summary>
      <ol class="rail-m__list">
        {
          SCENES.map((scene, i) => (
            <li>
              <a class="rail-m__link" href={`#${scene.id}`}>
                <span class="rail-m__num" aria-hidden="true">
                  {i + 1}
                </span>
                {scene.label}
              </a>
            </li>
          ))
        }
        <li class="rail-m__sep">
          <a class="rail-m__link rail-m__link--skip" href="#close"> Skip to the end </a>
        </li>
        <li>
          <a class="rail-m__link rail-m__link--jump" href="/speaking/"> Jump: book a talk </a>
        </li>
        <li class="rail-m__depth-item">
          <fieldset class="depth-dial depth-dial--mobile" data-depth-dial-mobile>
            <legend class="depth-dial__legend">Depth</legend>
            <div class="depth-dial__options">
              <label class="depth-dial__label">
                <input
                  class="depth-dial__radio"
                  type="radio"
                  name="depth-mobile"
                  value="skim"
                  data-depth-radio-mobile
                />
                <span class="depth-dial__text">Skim</span>
              </label>
              <label class="depth-dial__label depth-dial__label--checked">
                <input
                  class="depth-dial__radio"
                  type="radio"
                  name="depth-mobile"
                  value="overview"
                  data-depth-radio-mobile
                  checked
                />
                <span class="depth-dial__text">Overview</span>
              </label>
              <label class="depth-dial__label">
                <input
                  class="depth-dial__radio"
                  type="radio"
                  name="depth-mobile"
                  value="deep"
                  data-depth-radio-mobile
                />
                <span class="depth-dial__text">Deep dive</span>
              </label>
            </div>
          </fieldset>
        </li>
      </ol>
    </details>
  </div>
</nav>

<style>
  /* The rail is fixed chrome — it overlays the scroll-native page rather than
     consuming a column, so the locked scene DOM order is untouched. */
  .scene-rail {
    font-family: var(--font-family-base);
  }

  /* ── DESKTOP rail ──────────────────────────────────────────────────────────
     A slim, flat, right-edge vertical rail on raised cream with a left hairline
     (DESIGN scene-rail: width ~208px). Hidden on mobile (the .rail-m bar takes
     over). Fixed so it persists as the page scrolls. */
  .rail-d {
    display: none;
  }

  @media (min-width: 1024px) {
    .rail-d {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: 5;
      width: 208px;
      display: flex;
      flex-direction: column;
      padding: 26px 20px;
      background: var(--color-surface-raised);
      border-left: 1px solid var(--color-border-hairline);
    }

    /* The mobile sticky bar is desktop-irrelevant. */
    .rail-m {
      display: none;
    }
  }

  .rail-d__head {
    margin: 0 0 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border-hairline);
    font-size: 9.5px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-secondary);
  }

  .rail-d__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail-d__item {
    position: relative;
  }

  /* The whole tick+number+name row is ONE jump target, padded so the 9px dot
     grows to a ≥44px hit area (DESIGN tick-hit-area). A real <a> — JS-off. */
  .rail-d__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    padding: 7px 6px;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-meta);
    font-weight: var(--font-weight-regular);
    line-height: 1.2;
    color: var(--color-ink-secondary);
    text-decoration: none;
  }

  .rail-d__link:hover {
    color: var(--color-accent);
  }

  /* Visible keyboard focus — 2px navy ring, 2px offset (DESIGN tick-focus). */
  .rail-d__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* tick: 9px circle, 1px accent ring, transparent fill (DESIGN). Decorative. */
  .rail-d__tick {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-accent);
    background: transparent;
  }

  .rail-d__num {
    flex: 0 0 auto;
    width: 1.1em;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--color-ink-meta-min);
    font-variant-numeric: tabular-nums;
  }

  .rail-d__name {
    /* The scene-NAME carries the meaning; nothing relies on the tick alone. */
  }

  /* CURRENT scene — status is in WEIGHT + aria-current (never color alone). The
     navy edge-bar + the lit tick (with a flat outline halo, not a shadow) are
     redundant reinforcements. Driven by [aria-current] so the JS enhancement
     and the static baseline share one source of truth. */
  .rail-d__link[aria-current='true'] {
    color: var(--color-accent);
    font-weight: var(--font-weight-bold);
  }

  /* 3px navy edge-bar at the left of the current row (DESIGN tick-current). */
  .rail-d__link[aria-current='true']::before {
    content: '';
    position: absolute;
    left: -20px;
    top: 6px;
    bottom: 6px;
    width: 3px;
    background: var(--color-accent);
  }

  .rail-d__link[aria-current='true'] .rail-d__tick {
    background: var(--color-accent);
    /* The "soft halo" rendered as a flat ring via outline — NOT box-shadow (the
       flat system reserves shadow for the Guide alone; DESIGN §Elevation). */
    outline: 3px solid rgba(30, 58, 95, 0.2);
    outline-offset: 0;
  }

  /* PROGRESS meter — 5px track in grid-line, accent fill, radius 3px (DESIGN). */
  .rail-d__progress {
    margin: 18px 0 16px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border-hairline);
  }

  .rail-d__meter {
    height: 5px;
    margin-bottom: 7px;
    border-radius: 3px;
    background: var(--color-grid-line);
    overflow: hidden;
  }

  /* Static baseline: a filled bar at "Scene 1 of 7" (1/7 ≈ 14.3%). The animated
     scroll-driven width-fill is the ENHANCEMENT, applied only when motion is
     allowed (CSS layer of the two-layer gate) — it auto-degrades to this static
     bar under reduced-motion / unsupported browsers. */
  .rail-d__meter-fill {
    display: block;
    height: 100%;
    width: 14.3%;
    background: var(--color-accent);
    border-radius: 3px;
  }

  .rail-d__lab {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-secondary);
  }

  .rail-d__foot {
    margin-top: auto;
  }

  /* Skip to the end — outline button, 1px accent, radius 7px (DESIGN skip-button). */
  .rail-d__skip {
    display: block;
    padding: 9px 8px;
    border: 1px solid var(--color-accent);
    border-radius: 7px;
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-accent);
    text-decoration: none;
  }

  .rail-d__skip:hover {
    color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .rail-d__skip:focus-visible,
  .rail-d__jump:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .rail-d__jump {
    display: block;
    margin-top: 9px;
    text-align: center;
    font-size: 10.5px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    color: var(--color-ink-secondary);
    text-decoration: none;
  }

  .rail-d__jump:hover {
    color: var(--color-accent-hover);
  }

  /* ── MOBILE rail: sticky top progress bar + "Jump to section" disclosure ────
     Presentation-only reflow (same anchors); the page reading order is intact.
     A native <details> menu → 0-JS, keyboard-operable. Shown < 1024px. */
  .rail-m {
    position: sticky;
    top: 0;
    z-index: 9;
    background: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-border-hairline);
  }

  .rail-m__bar {
    height: 4px;
    background: var(--color-grid-line);
    overflow: hidden;
  }

  /* Static baseline fill (1/7); scroll-driven width-fill is the gated enhancement. */
  .rail-m__bar-fill {
    display: block;
    height: 100%;
    width: 14.3%;
    background: var(--color-accent);
  }

  .rail-m__menu {
    /* native disclosure */
  }

  .rail-m__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    list-style: none;
  }

  /* Hide the default marker; the "Jump to section ▾" text is the affordance. */
  .rail-m__summary::-webkit-details-marker {
    display: none;
  }

  .rail-m__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .rail-m__lab {
    font-size: 10px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-secondary);
  }

  .rail-m__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.03em;
    color: var(--color-accent);
  }

  .rail-m__list {
    margin: 0;
    padding: var(--space-2) 0 var(--space-3);
    list-style: none;
    border-top: 1px solid var(--color-border-hairline);
  }

  .rail-m__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    font-size: 14px;
    color: var(--color-ink-primary);
    text-decoration: none;
  }

  .rail-m__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .rail-m__num {
    flex: 0 0 auto;
    width: 1.4em;
    font-size: 11px;
    color: var(--color-ink-meta-min);
    font-variant-numeric: tabular-nums;
  }

  .rail-m__sep {
    margin-top: var(--space-2);
    border-top: 1px solid var(--color-border-hairline);
  }

  .rail-m__link--skip,
  .rail-m__link--jump {
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  .rail-m__depth-item {
    margin-top: var(--space-2);
    border-top: 1px solid var(--color-border-hairline);
    padding: var(--space-2) var(--space-4) var(--space-3);
  }

  /* ── Depth Dial (Story 5.2, AC1/AC3) ─────────────────────────────────────
     A native <fieldset> radio group — keyboard-operable (arrow keys navigate
     between radios, Tab to/from the group), state in the a11y tree via :checked
     (never color alone — color is a REDUNDANT reinforcement, not the signal).
     No box-shadow (DESIGN §Elevation flat system). NOT gated on motion (it is
     a control, not animation). */
  .depth-dial {
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3) var(--space-3);
    margin: 14px 0 12px;
  }

  .depth-dial__legend {
    padding: 0 var(--space-2);
    font-size: 9.5px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-secondary);
  }

  .depth-dial__options {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--space-2);
  }

  /* In mobile context the options flow horizontally to save vertical space. */
  .depth-dial--mobile .depth-dial__options {
    flex-direction: row;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .depth-dial__label {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 4px 6px;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-meta);
    font-weight: var(--font-weight-regular);
    color: var(--color-ink-secondary);
    cursor: pointer;
  }

  .depth-dial__label:hover {
    color: var(--color-accent);
  }

  /* The native radio — visible and sized for a ≥24px hit area contribution.
     State is carried via :checked in the a11y tree (the native affordance). */
  .depth-dial__radio {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    margin: 0;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .depth-dial__radio:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Checked label — REDUNDANT visual reinforcement (the :checked carries the
     real accessible signal; color is additional context only). */
  .depth-dial__label:has(input:checked) {
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }

  .depth-dial__text {
    line-height: 1.2;
  }

  /* ── The two-layer reduced-motion gate — CSS layer (Layer 1) ───────────────
     This is the CSS half of the shared two-layer gate documented in
     web/src/lib/motion.ts (CSS_REDUCED_MOTION_CONVENTION). The scroll-driven
     width-fill (the meter ENHANCEMENT) is authored ONLY inside the no-preference
     query, so under reduced motion the static filled bars above stand (EXPERIENCE
     State-Patterns: "static filled bar at Scene N of 7"). animation-timeline:
     scroll() drives the fill with zero JS; it is inert in browsers that do not
     support scroll-driven animations (progressive — they keep the static
     baseline). The JS init-guard (Layer 2) lives in the <script> below and is
     also sourced from motion.ts (onMotionAllowed). */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes scene-rail-fill {
      from {
        width: 0%;
      }
      to {
        width: 100%;
      }
    }

    .rail-d__meter-fill,
    .rail-m__bar-fill {
      width: 0%;
      animation: scene-rail-fill linear both;
      animation-timeline: scroll(root block);
    }
  }
</style>

{
  /*
  The single, tiny scene-rail enhancement (NFR-1, well under 1KB). It does the
  ONE thing CSS cannot: move the semantic aria-current + the "Scene N of 7"
  number to the in-view scene. It is the JS half (Layer 2) of the SHARED
  two-layer reduced-motion gate — it runs through onMotionAllowed() from
  web/src/lib/motion.ts, so it no-ops under reduced motion (the static baseline +
  the CSS scroll-fill already cover that case) via the ONE shared gate, never an
  inline per-component matchMedia. It never touches scroll (no scroll-jacking;
  the page is scroll-native). Astro bundles the motion.ts import; the result is
  still tiny and stays inlined (NFR-1 — verified by the build-output suite).
*/
}
<script>
  import { onMotionAllowed } from '../../lib/motion';

  // Layer 2 of the shared gate: onMotionAllowed runs this init ONLY when motion
  // is allowed (real matchMedia AND not prefers-reduced-motion: reduce). Under
  // reduced motion it no-ops and the static baseline (aria-current on #hero,
  // "Scene 1 of 7") stands as authored — no observer is created.
  onMotionAllowed(() => {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-scene-link]'));
    const labels = Array.from(document.querySelectorAll<HTMLElement>('[data-scene-current]'));
    const order = links.map((a) => a.dataset.sceneLink ?? '');
    const sections = order
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (links.length > 0 && sections.length > 0) {
      let activeId = order[0] ?? '';

      const setActive = (id: string) => {
        if (id === activeId) return;
        activeId = id;
        for (const a of links) {
          if (a.dataset.sceneLink === id) {
            a.setAttribute('aria-current', 'true');
          } else {
            a.removeAttribute('aria-current');
          }
        }
        const n = order.indexOf(id) + 1;
        if (n > 0) {
          for (const lab of labels) lab.textContent = String(n);
        }
      };

      // The scene whose top is nearest the upper third of the viewport wins —
      // a minimal "current section" heuristic, no scroll handler churn.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setActive(entry.target.id);
          }
        },
        { rootMargin: '-30% 0px -60% 0px', threshold: 0 },
      );

      for (const section of sections) observer.observe(section);

      // Bottom-of-page fallback (Story 5.0, [1.4]/[1.9]): the last scene (#close)
      // may not cross the interior rootMargin band before the page bottoms out.
      // A normal-flow (NOT absolutely-positioned) 1px sentinel appended as the last
      // child of document.body naturally sits at the true document foot regardless of
      // any ancestor's CSS positioning. A second IntersectionObserver fires
      // setActive(lastId) when this sentinel enters the viewport.
      //
      // IMPORTANT: do NOT use position:absolute;bottom:0 on a sentinel appended to a
      // non-positioned container — absolute positioning resolves against the nearest
      // positioned ancestor, which for a static <main> is the initial containing block
      // (the viewport box), placing the sentinel ~3000px above the true document foot.
      // A normal-flow sentinel at the end of <body> is the only reliable approach.
      //
      // This stays entirely inside onMotionAllowed (the ONE shared gate) so it is a
      // no-op under reduced motion and adds no new scroll handlers.
      const lastId = order[order.length - 1] ?? '';
      const sentinel = document.createElement('div');
      sentinel.setAttribute('aria-hidden', 'true');
      // Normal-flow: no position, no dimensions except 1px height so it occupies a
      // real position at the end of the document without affecting layout visually.
      sentinel.style.cssText = 'height:1px;pointer-events:none;overflow:hidden;';
      // Append as last child of body — a normal-flow element at the end of <body>
      // sits at the true document foot, regardless of ancestor positioning.
      document.body.appendChild(sentinel);
      const footObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setActive(lastId);
          }
        },
        // rootMargin '0px 0px 20px 0px' — extend the bottom of the intersection root by
        // 20px so the sentinel counts as "visible" when it is within ~20px of the viewport
        // bottom edge. Without this, a 1px sentinel sitting exactly at the viewport's bottom
        // pixel has intersectionRatio ≈ 0 and the observer may not fire consistently
        // (sub-pixel precision issue at the exact edge).
        // A 20px slack is tight enough that it only fires at true page-bottom scroll, not
        // before the visitor is near the end.
        { rootMargin: '0px 0px 20px 0px', threshold: 0 },
      );
      footObserver.observe(sentinel);
    }
  });
</script>

{
  /*
  Depth Dial enhancement (Story 5.2, AC1/AC3/AC4 — NFR-1).
  NOT motion-gated: the dial is a control, not animation. This tiny script:
    1. Sets data-depth on <html> so CSS can show/hide scene tiers.
    2. Syncs the desktop + mobile radio groups with each other and with $depth.
    3. Works without nanostores by using a custom event ('depth-change') so the
       GuidePanel island (which imports $depth from the store) can subscribe.
  JS-off fallback: the CSS tiers use [data-depth] — without it, the overview
  tier is the "visible default" (authored as the non-hidden baseline via CSS
  :not([data-depth]) or [data-depth="overview"] — whichever is appropriate).
*/
}
<script>
  import { $depth } from '../../lib/store';
  import type { Depth } from '../../lib/store';

  // Sync radios ↔ $depth ↔ data-depth on <html>.
  // Desktop radios: [data-depth-radio]; Mobile radios: [data-depth-radio-mobile].
  // The two groups use different `name` attributes so they don't interfere as a
  // native radio group — the script keeps them in sync manually.

  const desktopRadios = Array.from(
    document.querySelectorAll<HTMLInputElement>('[data-depth-radio]'),
  );
  const mobileRadios = Array.from(
    document.querySelectorAll<HTMLInputElement>('[data-depth-radio-mobile]'),
  );
  const allRadios = [...desktopRadios, ...mobileRadios];

  function isDepth(v: string): v is Depth {
    return v === 'skim' || v === 'overview' || v === 'deep';
  }

  function applyDepth(depth: Depth) {
    // Set data-depth on <html> (the CSS shows/hides tiers by this attribute).
    document.documentElement.setAttribute('data-depth', depth);
    // Sync all radio groups so both desktop and mobile reflect the state.
    for (const radio of allRadios) {
      radio.checked = radio.value === depth;
    }
  }

  // Initialize to the current store value and apply.
  applyDepth($depth.get());

  // When any radio changes, update the store (which triggers the subscriber below).
  for (const radio of allRadios) {
    radio.addEventListener('change', () => {
      const val = radio.value;
      if (isDepth(val)) {
        $depth.set(val);
      }
    });
  }

  // Subscribe to store changes (e.g. driven by the GuidePanel or future consumers).
  $depth.subscribe((depth) => {
    applyDepth(depth);
  });
</script>
