{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Build-time scripts run via `tsx` (never compiled to dist). tsx uses
    // bundler-style resolution (allowImportingTsExtensions: true, no .js
    // extension required on relative imports) — NOT strict NodeNext semantics.
    // Using moduleResolution:bundler here matches tsx's actual runtime behavior
    // and allows scripts to import cross-package files (e.g. web/src/data/*.ts)
    // that use extension-less relative imports. noEmit stays on (scripts are
    // executed directly by tsx, never compiled to dist).
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["**/*.ts"],
  // Test files are type-checked + run by Vitest (vitest.config.ts), discovered
  // via its `**/*.test.ts` glob (skill-rules Rule 8); excluded here so the
  // orchestrator typecheck doesn't require vitest's ambient types.
  "exclude": ["node_modules", "**/*.test.ts"]
}
